# Theme: omaled
# By: Brian Blakely

# Main bg
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#E66063"

# Title color for boxes
theme[title]="#EC8385"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#FF0022"

# Background color of selected item in processes box
theme[selected_bg]="#860111"

# Foreground color of selected item in processes box
theme[selected_fg]="#F6CACC"

# Color of inactive/disabled text
theme[inactive_fg]="#DD2C2F"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#E35053"

# Cpu box outline color
theme[cpu_box]="#DD2C2F"

# Memory/disks box outline color
theme[mem_box]="#BD1F21"

# Net up/down box outline color
theme[net_box]="#AC1C1E"

# Processes box outline color
theme[proc_box]="#D02224"

# Box divider line and small boxes line color
theme[div_line]="#5A000B"

# Temperature graph colors
theme[temp_start]="#AC1C1E"
theme[temp_mid]="#DD2C2F"
theme[temp_end]="#FF0022"

# CPU graph colors
theme[cpu_start]="#5A000B"
theme[cpu_mid]="#D02224"
theme[cpu_end]="#E66063"

# Mem/Disk free meter
theme[free_start]="#5A000B"
theme[free_mid]="#9C191B"
theme[free_end]="#BD1F21"

# Mem/Disk cached meter
theme[cached_start]="#5A000B"
theme[cached_mid]="#AC1C1E"
theme[cached_end]="#D02224"

# Mem/Disk available meter
theme[available_start]="#860111"
theme[available_mid]="#BD1F21"
theme[available_end]="#E35053"

# Mem/Disk used meter
theme[used_start]="#9C191B"
theme[used_mid]="#DD2C2F"
theme[used_end]="#FF0022"

# Download graph colors
theme[download_start]="#5A000B"
theme[download_mid]="#AC1C1E"
theme[download_end]="#E35053"

# Upload graph colors
theme[upload_start]="#860111"
theme[upload_mid]="#D02224"
theme[upload_end]="#E66063"
